# === Google Gemini ===
# Lấy key tại https://aistudio.google.com/apikey — KHÔNG commit key thật vào file này!
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# === ChromaDB ===
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=cv_chunks

# === Chunking ===
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# === App ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./data/uploads

# CORS: list[str] phải viết dạng JSON (pydantic-settings parse JSON cho kiểu list)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
